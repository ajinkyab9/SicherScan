// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id       String @id @default(uuid())
  projName String @db.VarChar(500)
  codeLang String @db.VarChar(50)
}

model Scan {
  id                  String      @id @default(uuid())
  userName            String      @db.VarChar(250)
  codeSnippet         String      @db.Text
  status              String      @default("PENDING")    
  createDate          DateTime    @default(now())       @db.Date
  createdAt           DateTime    @default(now())

  vulnerabilities     Vulnerability[]

  @@index([userName])
}

model Vulnerability {
  id                  String      @id @default(cuid())
  scanId              String      
  scan                Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  vulType             String      @db.VarChar(150)
  severity            String      @db.VarChar(20)
  cvssBaseScore       Float     
  description         String      @db.Text
  describedChanges    String      @db.Text
  fixedCode           String      @db.Text

  @@index([scanId])
  @@index([severity])
}