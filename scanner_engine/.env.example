# AI Provider Configuration 

# Uncomment the URL for your preferred local LLM runner.
# All of these support the standard OpenAI API format.

# Ollama (Default)
LLM_API_URL=http://localhost:11434/v1/chat/completions

# LM Studio
# LLM_API_URL=http://localhost:1234/v1/chat/completions

# Llama.cpp (Server)
# LLM_API_URL=http://localhost:8080/v1/chat/completions

# Jan.ai
# LLM_API_URL=http://localhost:1337/v1/chat/completions

# GPT4All
# LLM_API_URL=http://localhost:4891/v1/chat/completions

# Oobabooga (Text Generation WebUI)
# LLM_API_URL=http://127.0.0.1:5000/v1/chat/completions


# ==========================================
# AI Model Selection

# Set this to the exact name of the model you have downloaded.
# Note: LM Studio and Llama.cpp often ignore this field if only one model is loaded, whereas Ollama needs the exact tag

# Examples:
# - qwen2.5-coder:7b (Ollama)
# - llama3:8b (Ollama)
# - mradermacher/Qwen2.5-Coder-7B-Instruct-GGUF (LM Studio)
LLM_MODEL=qwen2.5-coder:7b